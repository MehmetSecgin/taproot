{
  "name": "@mehmetsecgin/taproot",
  "version": "0.10.0",
  "description": "Universal query orchestration CLI with plugin runtime (DB-first v1)",
  "type": "module",
  "license": "MIT",
  "author": "Mehmet Secgin <mehmetascgn@gmail.com>",
  "homepage": "https://github.com/MehmetSecgin/taproot#readme",
  "bugs": {
    "url": "https://github.com/MehmetSecgin/taproot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehmetSecgin/taproot.git"
  },
  "keywords": [
    "cli",
    "database",
    "mysql",
    "postgres",
    "tidb",
    "teleport",
    "query",
    "orchestration",
    "schema-learning"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "taproot": "dist/index.js",
    "taprootd": "dist/daemon-main.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/daemon-main.ts --format esm --dts --out-dir dist --clean --external keytar",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "log-symbols": "^7.0.1",
    "mysql2": "^3.15.2",
    "node-sql-parser": "^5.4.0",
    "ora": "^9.3.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "protobufjs": "^8.4.2",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
