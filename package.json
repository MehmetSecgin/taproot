{
  "name": "@mehmetsecgin/taproot",
  "version": "2.0.0",
  "private": true,
  "description": "Universal query orchestration CLI with plugin runtime (DB-first v1)",
  "type": "module",
  "license": "MIT",
  "author": "Mehmet Secgin <mehmetascgn@gmail.com>",
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "taproot": "dist/index.js",
    "taprootd": "dist/daemon-main.js"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./plugins/mysql": {
      "types": "./dist/plugins/mysql.d.ts",
      "import": "./dist/plugins/mysql.js"
    },
    "./plugins/redis": {
      "types": "./dist/plugins/redis.d.ts",
      "import": "./dist/plugins/redis.js"
    },
    "./plugins/grpc": {
      "types": "./dist/plugins/grpc.d.ts",
      "import": "./dist/plugins/grpc.js"
    },
    "./plugins/teleport": {
      "types": "./dist/plugins/teleport.d.ts",
      "import": "./dist/plugins/teleport.js"
    },
    "./plugins/teleport-mysql": {
      "types": "./dist/plugins/teleport-mysql.d.ts",
      "import": "./dist/plugins/teleport-mysql.js"
    },
    "./plugins/kubectl-portforward": {
      "types": "./dist/plugins/kubectl-portforward.d.ts",
      "import": "./dist/plugins/kubectl-portforward.js"
    }
  },
  "files": [
    "dist",
    "scripts/make-mtls-certs.sh"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "commander": "^14.0.3",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "protobufjs": "^8.8.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "oxlint": "^1.94.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "keytar": true,
    "esbuild": true,
    "protobufjs": false,
    "fsevents": false
  }
}
