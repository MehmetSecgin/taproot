{
  "name": "@mehmetsecgin/taproot",
  "version": "1.10.9",
  "private": true,
  "description": "Universal query orchestration CLI with plugin runtime (DB-first v1)",
  "type": "module",
  "license": "MIT",
  "author": "Mehmet Secgin <mehmetascgn@gmail.com>",
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "taproot": "dist/index.js",
    "taprootd": "dist/daemon-main.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/daemon-main.ts --format esm --dts --out-dir dist --clean --external keytar",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "protobufjs": "^8.8.1",
    "yaml": "^2.8.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
