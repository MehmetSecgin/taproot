{
  "name": "@mehmetsecgin/taproot",
  "version": "1.11.0",
  "description": "CLI for querying MySQL/TiDB, Redis and gRPC datasources, built for AI agents",
  "keywords": [
    "cli",
    "mysql",
    "tidb",
    "redis",
    "grpc",
    "ai-agents"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Mehmet Secgin <mehmetascgn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehmetSecgin/taproot.git"
  },
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "taproot": "dist/index.js",
    "taprootd": "dist/daemon-main.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/daemon-main.ts --format esm --dts --out-dir dist --clean --external keytar",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "commander": "^14.0.3",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "protobufjs": "^8.8.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
