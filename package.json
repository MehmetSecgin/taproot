{
  "name": "telequery",
  "version": "0.1.0",
  "description": "Universal query orchestration CLI with plugin runtime (DB-first v1)",
  "type": "module",
  "private": true,
  "bin": {
    "telequery": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "mysql2": "^3.15.2",
    "pino": "^10.1.0",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
